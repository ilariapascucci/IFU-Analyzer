# Ignore all FITS files by default
*.fits
*.csv
*.ecsv
*.pyc
*.ipynb
*.txt
!requirements.txt
!requirements-lock.txt
# nirspec_disp/ is committed: the JWST NIRSpec resolving-power tables get_spectral_resolution reads.
!/nirspec_disp/*.fits

# Ignore any large data folders
/data/
# hitran_local/ is committed: the offline HITRAN starter pack, built by
# warm_hitran_cache.py. Only on-demand fetches (in hitran_cache/) are ignored.
/hitran_cache/
# lst_local/ is committed: the LST line catalog the rest-line picker reads, with its ReadMe.
!/lst_local/*.txt
/CO/
/cube_explorer/__pycache__/

# Ignore generated content
/.claude/
CLAUDE.md
.claudeignore
