# Ignore all FITS files by default
*.fits
*.csv
*.ecsv
*.pyc
*.ipynb
*.txt
!requirements.txt

# Ignore any large data folders
/data/
# hitran_local/ is committed: the offline HITRAN starter pack, built by
# warm_hitran_cache.py. Only on-demand fetches (in hitran_cache/) are ignored.
/hitran_cache/
/CO/
/cube_explorer/__pycache__/

# Ignore generated content
/.claude/
CLAUDE.md
.claudeignore
